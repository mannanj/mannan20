e2e/screenshots/

# Audio source files (production serves from R2)
public/data/audio/

# Lock files (using bun.lockb)
package-lock.json
pnpm-lock.yaml
yarn.lock
.claude/session-memory/

# Kick the Can — archived Shockwave game preservation (vendored ~470MB DirPlayer.app + game assets, not for the repo)
scripts/kick-the-can-dirplayer/
wants/kick-the-can/
.claude/handoff/

# Redesign exploration artifacts (local only)
.claude/redesign/
.claude/redesign-shots/

# Brainstorming visual-companion mockups (local only)
.superpowers/
.worktrees/

# Leftovers from the removed .githooks/post-commit hook. Nothing writes or reads
# them now; the entries stay so existing local copies do not show up as untracked.
public/data/dev-commits.json
public/data/metadata.json

# Decrypted Sun Signal transcripts. The password-protected archive is the only
# copy that belongs in the repo; the plaintext one is built by
# scripts/build-transcripts-archive.mjs and served from private R2.
sun-signal-transcripts.zip
**/transcripts.plain.zip
videos/sun-signal-light/transcripts/*.plain.zip
# Both archives now live in the private mannan20-gated R2 bucket. See
# videos/sun-signal-light/transcripts/ARCHIVES.md — nothing zip-shaped belongs here.
videos/sun-signal-light/transcripts/*.zip

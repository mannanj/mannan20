{
  "tools": [
    {
      "name": "plan_drive_window",
      "description": "Scan a departure window for a drive and rank candidate leave times by predicted traffic-aware duration.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "origin": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Start address or place name."
          },
          "destination": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Destination address or place name."
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Local date of travel, YYYY-MM-DD."
          },
          "start": {
            "type": "string",
            "pattern": "^\\d{2}:\\d{2}$",
            "description": "Window start, HH:MM."
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#",
        "required": [
          "origin",
          "destination",
          "date",
          "start"
        ]
      }
    },
    {
      "name": "validate_place",
      "description": "Resolve a free-text address or place name to a specific, routable location before planning.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#",
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "create_invite",
      "description": "Admin only. Mint single-use invitation links.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 1,
            "description": "How many invitation links to create."
          },
          "label": {
            "type": "string",
            "maxLength": 80
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    }
  ]
}
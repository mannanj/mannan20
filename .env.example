# Copy to .env.local and fill in. Only the Turnstile block is documented here;
# see the READMEs for the rest.

# Cloudflare Turnstile — contact form bot protection.
#
# These are Cloudflare's documented test keys. They always pass, run against
# Cloudflare's real endpoints, and are safe to commit. Production uses the real
# widget's keys, set in .env.local (public) and as a Worker secret (private).
#
#   sitekey  1x00000000000000000000AA  always passes, visible widget
#            2x00000000000000000000AB  always blocks
#            3x00000000000000000000FF  forces an interactive challenge
#
TURNSTILE_SITE_KEY=1x00000000000000000000AA

# The siteverify Worker the browser posts its token to. Point this at a local
# `cd turnstile-worker && bun run dev` while developing; production points at
# https://turnstile-siteverify-mannan20.mannanteam.workers.dev
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Copy to .env.local and fill in. Only the Turnstile block is documented here;
# see the READMEs for the rest.

# Cloudflare Turnstile — contact form bot protection.
#
# These are Cloudflare's documented test keys. They always pass, run against
# Cloudflare's real endpoints, and are safe to commit. Production uses the real
# widget's keys, set in .env.local (public) and as a Worker secret (private).
#
#   sitekey  1x00000000000000000000AA  always passes, visible widget
#            2x00000000000000000000AB  always blocks
#            3x00000000000000000000FF  forces an interactive challenge
#
TURNSTILE_SITE_KEY=1x00000000000000000000AA

# The siteverify Worker the browser posts its token to. Point this at a local
# `cd turnstile-worker && bun run dev` while developing; production points at
# https://turnstile-siteverify-mannan20.mannanteam.workers.dev
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Blink front door (mannan.is/blink + /api/mcp/blink). Secret values live only in the
# Worker secret store / login keychain, never in a file.
#   BLINK_GRANT_SECRET   Worker secret, shared with the blink Worker (keychain: blink-grant-secret)
#   BLINK_CALLBACK_URL   fixed grant callback: https://blink.mannan.is/auth/callback (staging: its own host)
#   BLINK_ALLOWED_EMAILS Worker secret, comma-separated allowed addresses (keychain: blink-allowed-emails);
#                        private, never committed. Unset = nobody allowed.
# BLINK_GRANT_SECRET=
# BLINK_CALLBACK_URL=
# BLINK_ALLOWED_EMAILS=

# Fresh Start sign-in bridge (/api/mcp/fresh-start). The app itself lives in its own repo
# (~/Documents/scripts/fresh-start); only this bridge and the /fresh redirect are here.
#   FRESH_START_GRANT_SECRET   Worker secret, shared with the fresh-start Worker (keychain: fresh-start-grant-secret)
#   FRESH_START_CALLBACK_URL   fixed grant callback: https://fresh-start.mannanteam.workers.dev/auth/callback
# Who may sign in: the app access table (site_apps 'fresh-start', public).
# FRESH_START_GRANT_SECRET=
# FRESH_START_CALLBACK_URL=
